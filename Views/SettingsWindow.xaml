<Window x:Class="PerfOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="性能浮窗设置"
        Width="762"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- 提示小圈：给「体感参考」这类口径做说明。
             14 DIP，与温度那个感叹号同尺寸，不抢布局也不改变行的基线；
             颜色用中性 hint 色，hover 才转强调色 —— 它不是警告，只是说明。 -->
        <Style x:Key="InfoTip" TargetType="Border">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextHint}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 温度项旁边的感叹号：只在「该装驱动」或「缺管理员」时出现，
             14 DIP 的小圆点，不抢布局、不改变行的基线。 -->
        <Style x:Key="TempWarn" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Disc" Fill="{DynamicResource Warning}" />
                            <TextBlock Text="!" FontSize="9.5" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,0,0,0.5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource WarningHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 颜色色块：选了就套一圈强调色，白块在浅底上也靠这圈边看得见 -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Ring" CornerRadius="14" BorderThickness="2"
                                    BorderBrush="{DynamicResource SwatchRing}"
                                    Background="{DynamicResource InputBg}" />
                            <Border CornerRadius="8" Margin="6" Background="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource SwatchRingHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= 标题栏（单行，高 40） ================= -->
            <Grid Grid.Row="0" Height="40" Background="{DynamicResource TitleBarBg}" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="性能浮窗" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    <!-- 版本号由代码填（UpdateChecker.CurrentVersion），避免 XAML 里写死一份 -->
                    <TextBlock x:Name="TxtProduct" Text="PerfOverlay" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="8,1,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="显示控制面板" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" />

                <Button x:Name="BtnClose" Width="28" Height="28" HorizontalAlignment="Right"
                        Margin="0,0,12,0" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="OnCloseClick" ToolTip="关闭（继续后台运行）">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                                <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource CloseIcon}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseHoverBg}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ================= 内容：2x2 对齐网格，一屏显示完，不滚动 ================= -->
            <!-- 同行两张卡等高（Grid 行高取两者最大值，卡片默认 Stretch），
                 列宽也等分。卡片内容垂直居中，多出来的空隙上下均分，
                 这样既严格对齐，也不会出现「底部一大块空白」。 -->
            <Grid x:Name="ContentRoot" Grid.Row="1" Margin="20,14,20,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== 左上：显示项目（两列 × 五行） =====
                     0.9.5 把「温度 CT/GT」拆成 CT、GT 两个开关，项目从 8 个变 9 个。
                     仍然用两列（左侧 4 项、右侧 5 项），只是行间隙从 12 收到 10、
                     卡片内边距从 15,13 收到 14,12：多出来的一行不至于把窗口撑高，
                     文字也一个字都不用缩。 -->
                <Border x:Name="CardDisplay" Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="显示项目" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 第一列：性能三项 + 帧率（四个老项目，位置不动） -->
                            <CheckBox x:Name="ChkCpu" Grid.Row="0" Grid.Column="0"
                                      Style="{StaticResource Switch}" Content="CPU 使用率"
                                      Margin="0,0,0,10" Checked="OnAnyOptionChanged" Unchecked="OnAnyOptionChanged" />
                            <CheckBox x:Name="ChkMem" Grid.Row="1" Grid.Column="0"
                                      Style="{StaticResource Switch}" Content="内存使用率"
                                      Margin="0,0,0,10" Checked="OnAnyOptionChanged" Unchecked="OnAnyOptionChanged" />
                            <CheckBox x:Name="ChkFps" Grid.Row="2" Grid.Column="0"
                                      Style="{StaticResource Switch}" Content="帧数"
                                      ToolTip="前台程序的帧数（游戏 / 播放器）"
                                      Margin="0,0,0,10" Checked="OnAnyOptionChanged" Unchecked="OnAnyOptionChanged" />
                            <CheckBox x:Name="ChkLow" Grid.Row="3" Grid.Column="0"
                                      Style="{StaticResource Switch}" Content="1% Low"
                                      ToolTip="最近 10 秒最差 1% 帧的平均帧率"
                                      Margin="0,0,0,10"
                                      Checked="OnAnyOptionChanged" Unchecked="OnAnyOptionChanged" />

                            <!-- 显示延迟：默认关。取数走 PresentMon 的 ETW，
                                 不依赖任何显卡厂商 SDK，NVIDIA / AMD / Intel 通用。
                                 默认关只是因为多开一路采集，不是因为取不到数。
                                 小圈里只留体感参考，不写适用范围。 -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal">
                                <CheckBox x:Name="ChkLatency"
                                          Style="{StaticResource Switch}" Content="显示延迟"
                                          ToolTip="Present 调用到画面真正出现在屏幕上的毫秒数（中位数）"
                                          Checked="OnAnyOptionChanged" Unchecked="OnAnyOptionChanged" />
                                <Border Style="{StaticResource InfoTip}">
                                    <TextBlock Text="i" FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextHint}" />
                                    <Border.ToolTip>
                                        <ToolTip MaxWidth="330">
                                            <StackPanel>
                                                <TextBlock Text="体感参考（中位数）" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBlock TextWrapping="Wrap"
                                                           Text="· ≤ 8 ms　几乎无感&#10;· 8–17 ms　顺畅（60Hz 一帧约 16.7 ms）&#10;· 17–33 ms　轻微发钝，快速转视角能察觉&#10;· 33–50 ms　明显拖手&#10;· &gt; 50 ms　卡顿可感知" />
                                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.75"
                                                           Text="这是出屏延迟，不含鼠标/手柄到游戏引擎的那一段；跟 NVIDIA Reflex 的端到端数字不能直接比。" />
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                </Border>
                            </StackPanel>

                            <!-- 第二列：显存 / 时间 / GPU / CT / GT（默认关闭的都在这一列） -->
                            <CheckBox x:Name="ChkVram" Grid.Row="0" Grid.Column="2"
                                      Style="{StaticResource Switch}" Content="显存"
                                      ToolTip="显存利用率"
                                      Margin="0,0,0,10" Checked="OnAnyOptionChanged" Unchecked="OnAnyOptionChanged" />
                            <CheckBox x:Name="ChkClock" Grid.Row="1" Grid.Column="2"
                                      Style="{StaticResource Switch}" Content="时间"
                                      ToolTip="时:分，固定显示在最右，前面用一条竖线与指标隔开"
                                      Margin="0,0,0,10" Checked="OnAnyOptionChanged" Unchecked="OnAnyOptionChanged" />
                            <CheckBox x:Name="ChkGpu" Grid.Row="2" Grid.Column="2"
                                      Style="{StaticResource Switch}" Content="GPU 使用率"
                                      ToolTip="整卡利用率（WDDM 引擎计数器，与任务管理器同源，NVIDIA / AMD / Intel 通用）"
                                      Margin="0,0,0,10" Checked="OnAnyOptionChanged" Unchecked="OnAnyOptionChanged" />
                            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal">
                                <CheckBox x:Name="ChkCpuTemp"
                                          Style="{StaticResource Switch}" Content="CPU 温度 (CT)"
                                          ToolTip="先读 ACPI 热区（免驱动）；读不到时，AMD（Zen1~Zen5）与 Intel Core 都可以装一次 PawnIO 驱动直读温度"
                                          Margin="0,0,0,10"
                                          Checked="OnAnyOptionChanged" Unchecked="OnAnyOptionChanged" />
                                <Button x:Name="BtnTempWarn" Style="{StaticResource TempWarn}"
                                        Visibility="Collapsed" Click="OnTempWarnClick"
                                        Margin="3,0,0,10"
                                        ToolTip="CPU 温度取不到，点这里看原因" />
                            </StackPanel>
                            <CheckBox x:Name="ChkGpuTemp" Grid.Row="4" Grid.Column="2"
                                      Style="{StaticResource Switch}" Content="GPU 温度 (GT)"
                                      ToolTip="走 WDDM 适配器性能数据，免驱动、免管理员，NVIDIA / AMD 通用"
                                      Checked="OnAnyOptionChanged" Unchecked="OnAnyOptionChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 右上：外观 ===== -->
                <Border x:Name="CardAppearance" Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="15,13">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="外观" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                        <!-- 主题：深色 / 浅色 / 跟随系统。切换即时生效，不需要重启，
                             面板本身、右键菜单与托盘菜单会一起变色（主题字典整份替换）。 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主题" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="13" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- 三个选项各带一枚缩略图：缩略图里画的是「那个主题长什么样」，
                                     配色写死（浅=白底深字，深=深底浅字），**不跟当前主题走** ——
                                     它的语义是预览，不是装饰，跟着当前主题变色就失去意义了。 -->
                                <RadioButton x:Name="SegThemeLight" Style="{StaticResource SegButton}" Padding="9,6"
                                             GroupName="theme" Checked="OnThemeChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="17" Height="12" CornerRadius="3" Background="#FFFFFFFF"
                                                BorderBrush="#FFA9BBD2" BorderThickness="1" />
                                        <TextBlock Text="浅色" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SegThemeDark" Style="{StaticResource SegButton}" Padding="9,6"
                                             GroupName="theme" Checked="OnThemeChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="17" Height="12" CornerRadius="3" Background="#FF10161F"
                                                BorderBrush="#FF6E819A" BorderThickness="1" />
                                        <TextBlock Text="深色" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SegThemeAuto" Style="{StaticResource SegButton}" Padding="9,6"
                                             Margin="0" GroupName="theme" Checked="OnThemeChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="17" Height="12" CornerRadius="3"
                                                BorderBrush="#FF8296AF" BorderThickness="1">
                                            <Border.Background>
                                                <!-- 左半白右半深：一眼看出「跟系统走」 -->
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                    <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                                    <GradientStop Color="#FF1B2431" Offset="0.5" />
                                                    <GradientStop Color="#FF1B2431" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="跟随系统" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="字号" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="13" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="SegS" Style="{StaticResource SegButton}" Content="小"
                                             Padding="12,5" GroupName="size" Checked="OnSizeChanged" />
                                <RadioButton x:Name="SegM" Style="{StaticResource SegButton}" Content="中"
                                             Padding="12,5" GroupName="size" Checked="OnSizeChanged" />
                                <RadioButton x:Name="SegL" Style="{StaticResource SegButton}" Content="大"
                                             Padding="12,5" GroupName="size" Checked="OnSizeChanged" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="刷新间隔" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="13" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="SegR250" Style="{StaticResource SegButton}" Content="0.25s"
                                             Padding="9,5" Margin="0,0,5,0" GroupName="rate" Checked="OnRateChanged" />
                                <RadioButton x:Name="SegR500" Style="{StaticResource SegButton}" Content="0.5s"
                                             Padding="9,5" Margin="0,0,5,0" GroupName="rate" Checked="OnRateChanged" />
                                <RadioButton x:Name="SegR1000" Style="{StaticResource SegButton}" Content="1s"
                                             Padding="9,5" Margin="0,0,5,0" GroupName="rate" Checked="OnRateChanged" />
                                <RadioButton x:Name="SegR2000" Style="{StaticResource SegButton}" Content="2s"
                                             Padding="9,5" Margin="0" GroupName="rate" Checked="OnRateChanged" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="不透明度" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="13" />
                            <Slider x:Name="SldOpacity" Grid.Column="1" Style="{StaticResource FlatSlider}"
                                    Minimum="0.3" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    ValueChanged="OnOpacityChanged" />
                            <TextBlock x:Name="TxtOpacity" Grid.Column="2" Width="38" TextAlignment="Right"
                                       VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文字颜色" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="13" />
                            <StackPanel x:Name="ColorRow" Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <RadioButton x:Name="Sw0" Style="{StaticResource Swatch}" Tag="#FFFFFF"
                                             Background="#FFFFFF" ToolTip="白" GroupName="color"
                                             Checked="OnColorChanged" />
                                <RadioButton x:Name="Sw1" Style="{StaticResource Swatch}" Tag="#FFD84D"
                                             Background="#FFD84D" ToolTip="黄" GroupName="color"
                                             Checked="OnColorChanged" />
                                <RadioButton x:Name="Sw2" Style="{StaticResource Swatch}" Tag="#5CE1E6"
                                             Background="#5CE1E6" ToolTip="青" GroupName="color"
                                             Checked="OnColorChanged" />
                                <RadioButton x:Name="Sw3" Style="{StaticResource Swatch}" Tag="#7DFF9E"
                                             Background="#7DFF9E" ToolTip="绿" GroupName="color"
                                             Checked="OnColorChanged" />
                                <RadioButton x:Name="Sw4" Style="{StaticResource Swatch}" Tag="#FF9F45"
                                             Background="#FF9F45" ToolTip="橙" GroupName="color"
                                             Checked="OnColorChanged" />
                                <RadioButton x:Name="Sw5" Style="{StaticResource Swatch}" Tag="#101418"
                                             Background="#101418" ToolTip="近黑" GroupName="color"
                                             Checked="OnColorChanged" Margin="0" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ChkOutline" Style="{StaticResource Switch}"
                                  Content="文字描边（关掉只剩纯色文字）"
                                  Checked="OnAnyOptionChanged" Unchecked="OnAnyOptionChanged" />
                    </StackPanel>
                </Border>

                <!-- ===== 左下：行为 ===== -->
                <Border x:Name="CardBehavior" Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="15,13">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="行为" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                        <CheckBox x:Name="ChkLock" Style="{StaticResource Switch}" Content="锁定位置（不可拖动）"
                                  Margin="0,0,0,12" Checked="OnAnyOptionChanged" Unchecked="OnAnyOptionChanged" />
                        <CheckBox x:Name="ChkThrough" Style="{StaticResource Switch}" Content="鼠标穿透（点不到浮窗）"
                                  Margin="0,0,0,12" Checked="OnAnyOptionChanged" Unchecked="OnAnyOptionChanged" />
                        <CheckBox x:Name="ChkStartup" Style="{StaticResource Switch}" Content="开机自动启动（当前用户）"
                                  Margin="0,0,0,12" Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
                        <CheckBox x:Name="ChkTray" Style="{StaticResource Switch}" Content="显示托盘图标"
                                  Checked="OnAnyOptionChanged" Unchecked="OnAnyOptionChanged" />

                        <!-- 两行两列：左列标签、右列控件，两行的控件左边缘必须落在同一竖线，
                             所以共用同一个 Grid 的列，不各写一套。 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="浮窗位置" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="12,0,0,0">
                                <RadioButton x:Name="PosLeft" Content="左上" Style="{StaticResource SegButton}"
                                             Click="OnPositionPicked" />
                                <RadioButton x:Name="PosCenter" Content="中上" Style="{StaticResource SegButton}"
                                             Click="OnPositionPicked" />
                                <RadioButton x:Name="PosRight" Content="右上" Style="{StaticResource SegButton}"
                                             Margin="0" Click="OnPositionPicked" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="浮窗显示快捷键" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <Border Grid.Row="1" Grid.Column="1" x:Name="HotkeyBox" Height="28"
                                    Margin="12,10,0,0"
                                    Background="{DynamicResource InputBg}"
                                    BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1"
                                    CornerRadius="6" Cursor="Hand" Focusable="True"
                                    FocusVisualStyle="{x:Null}"
                                    MouseLeftButtonDown="OnHotkeyBoxClick"
                                    PreviewKeyDown="OnHotkeyKeyDown"
                                    LostKeyboardFocus="OnHotkeyLostFocus"
                                    ToolTip="点一下再按组合键；Esc 取消，退格清除">
                                <TextBlock x:Name="TxtHotkey" Text="未设置" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                           Margin="8,0" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <TextBlock Text="关闭本窗口不退出程序，浮窗继续在后台运行。"
                                   Style="{StaticResource Hint}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- ===== 右下：帧数采集 =====
                     这张卡不再被左卡拉到等高：卡片贴顶、高度只包住内容，下边缘自然上移；
                     「恢复默认 / 完成」沉到该列底部，正好落在窗口右下角。 -->
                <Grid Grid.Row="2" Grid.Column="2">
                    <Border x:Name="CardFrame" Style="{StaticResource Card}" Padding="15,13"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="帧数采集" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                            <TextBlock Text="帧数、1% Low 与 CPU 温度需要管理员权限。开机自启时会弹授权框，点「是」即可。"
                                       FontSize="12" LineHeight="19" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="{DynamicResource DotIdle}"
                                         VerticalAlignment="Top" Margin="0,5,7,0" />
                                <TextBlock x:Name="TxtFrameStatus" Text="检测中…" FontSize="12.5"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap" MaxWidth="278" />
                            </StackPanel>

                            <Button x:Name="BtnElevate" Content="以管理员身份启动" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Padding="14,6" Margin="0,12,0,0"
                                    Click="OnElevateClick" />
                        </StackPanel>
                    </Border>

                    <Grid VerticalAlignment="Bottom">
                        <!-- 这一行挤了三个按钮，左边提示语要跟着收短：
                             「改动即时生效并自动保存」有 132 DIP 宽，右列只有 353，会让文字钻到按钮底下。 -->
                        <TextBlock Text="改动自动保存" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnAbout" Content="版本与更新" Style="{StaticResource GhostButton}"
                                    Padding="10,6" Margin="0,0,8,0" Click="OnAboutClick" />
                            <Button x:Name="BtnDefaults" Content="恢复默认" Style="{StaticResource GhostButton}"
                                    Padding="10,6" Margin="0,0,8,0" Click="OnResetDefaults" />
                            <Button x:Name="BtnDone" Content="完成" Style="{StaticResource PrimaryButton}"
                                    Padding="16,6" Click="OnCloseClick" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
