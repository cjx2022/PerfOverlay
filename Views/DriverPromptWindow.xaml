<Window x:Class="PerfOverlay.Views.DriverPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU 温度"
        Width="432"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Border BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="38" Background="{DynamicResource TitleBarBg}" MouseLeftButtonDown="OnTitleBarMouseDown">
                <TextBlock Text="CPU 温度" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="18,0" VerticalAlignment="Center" />

                <Button Width="28" Height="28" HorizontalAlignment="Right"
                        Margin="0,0,10,0" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="OnCancelClick" ToolTip="关闭">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                                <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource CloseIcon}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseHoverBg}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" Margin="20,16,20,16">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="20" Height="20" VerticalAlignment="Top">
                        <Ellipse Fill="{DynamicResource Warning}" />
                        <TextBlock Text="!" FontSize="13" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,0,0,1" />
                    </Grid>
                    <TextBlock x:Name="TxtHead" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="9,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock x:Name="TxtBody" FontSize="12.5" LineHeight="20"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,12,0,0" TextWrapping="Wrap" />

                <Border x:Name="BoxStatus" CornerRadius="7" Padding="11,8" Margin="0,12,0,0"
                        Background="{DynamicResource SoftBox}" Visibility="Collapsed">
                    <TextBlock x:Name="TxtStatus" FontSize="12" LineHeight="18"
                               Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource GhostButton}"
                            Click="OnCancelClick" />
                    <Button x:Name="BtnPrimary" Content="下载并安装" Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0" Click="OnPrimaryClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
