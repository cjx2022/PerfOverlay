<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>PerfOverlay</AssemblyName>
    <RootNamespace>PerfOverlay</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>

    <!-- 版本与署名 -->
    <Version>0.9.4</Version>
    <AssemblyVersion>0.9.4.0</AssemblyVersion>
    <FileVersion>0.9.4.0</FileVersion>
    <InformationalVersion>0.9.4</InformationalVersion>
    <AssemblyTitle>PerfOverlay 性能浮窗</AssemblyTitle>
    <Product>PerfOverlay</Product>
    <Description>轻量桌面性能浮窗：CPU / 内存 / 帧数 / 1% Low / 显存 / GPU / 温度 / 时间</Description>
    <Company>BillChen</Company>
    <Authors>BillChen</Authors>
    <Copyright>Copyright (c) 2026 BillChen</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <!-- 别把 commit sha 拼进 ProductVersion（SDK 默认会加 "+<sha>"，发布物上不干净） -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- GeneratePathProperty：把包的实际解包路径暴露成 $(Pkg<Name>) 变量，
         下面才能把 dll 内嵌进 exe（发布物保持单文件） -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" GeneratePathProperty="true" />
    <PackageReference Include="HidSharp" Version="2.1.0" GeneratePathProperty="true" />
    <PackageReference Include="System.CodeDom" Version="9.0.0" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <!-- _tools 下是配套的验证小工具（独立项目），不要被主项目编译进去 -->
  <ItemGroup>
    <Compile Remove="_tools\**" />
    <Page Remove="_tools\**" />
    <None Remove="_tools\**" />
    <EmbeddedResource Remove="_tools\**" />
  </ItemGroup>

  <!--
    PresentMon 以嵌入资源的形式打进 exe，发布物因此只有一个文件；
    首次运行释放到 %LOCALAPPDATA%\PerfOverlay\bin\<版本>\（见 PresentMonProvider）。
    不再复制到输出目录，发布包里也就不会多出一个 tools 文件夹。
  -->
  <ItemGroup>
    <EmbeddedResource Include="tools\PresentMon.exe" LogicalName="PerfOverlay.PresentMon.exe" />
  </ItemGroup>

  <!--
    温度采集要读 CPU 的 MSR / SMN，只能靠 LibreHardwareMonitor（它自带已签名的内核驱动）。
    这三个 dll 同样内嵌进 exe，发布物才还是一个文件；运行时由 App 的 AssemblyResolve
    从资源里加载 —— 只有用户真的打开「温度」才会走到那一步，平时连内存都不占。
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(PkgLibreHardwareMonitorLib)\lib\net472\LibreHardwareMonitorLib.dll"
                      LogicalName="PerfOverlay.Deps.LibreHardwareMonitorLib.dll" />
    <EmbeddedResource Include="$(PkgHidSharp)\lib\netstandard2.0\HidSharp.dll"
                      LogicalName="PerfOverlay.Deps.HidSharp.dll" />
    <EmbeddedResource Include="$(PkgSystem_CodeDom)\lib\netstandard2.0\System.CodeDom.dll"
                      LogicalName="PerfOverlay.Deps.System.CodeDom.dll" />
  </ItemGroup>

</Project>
