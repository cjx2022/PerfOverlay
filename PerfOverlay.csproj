<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>PerfOverlay</AssemblyName>
    <RootNamespace>PerfOverlay</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>

    <!-- 版本与署名 -->
    <Version>0.9.8</Version>
    <AssemblyVersion>0.9.8.0</AssemblyVersion>
    <FileVersion>0.9.8.0</FileVersion>
    <InformationalVersion>0.9.8</InformationalVersion>
    <AssemblyTitle>PerfOverlay 性能浮窗</AssemblyTitle>
    <Product>PerfOverlay</Product>
    <Description>轻量桌面性能浮窗：CPU / 内存 / 帧数 / 1% Low / 显存 / GPU / 温度 / 时间</Description>
    <Company>BillChen</Company>
    <Authors>BillChen</Authors>
    <Copyright>Copyright (c) 2026 BillChen</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <!-- 别把 commit sha 拼进 ProductVersion（SDK 默认会加 "+<sha>"，发布物上不干净） -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 运行时零第三方依赖：GPU 占用率走 PDH、GPU 温度走 WDDM、CPU 温度走 ACPI 热区，
         全部是 Windows 自带接口。这里只留编译用的参考程序集，不进发布物。 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Configuration" />
    <!-- ACPI 热区（root\WMI）走 System.Management，net48 框架自带，不额外内嵌 -->
    <Reference Include="System.Management" />
  </ItemGroup>

  <!-- _tools 下是配套的验证小工具（独立项目），不要被主项目编译进去；
       _test 是排障用的一次性脚本与参考源码，同样不能进编译（里面有从上游拉下来的 .cs） -->
  <ItemGroup>
    <Compile Remove="_tools\**" />
    <Page Remove="_tools\**" />
    <None Remove="_tools\**" />
    <EmbeddedResource Remove="_tools\**" />

    <Compile Remove="_test\**" />
    <Page Remove="_test\**" />
    <None Remove="_test\**" />
    <EmbeddedResource Remove="_test\**" />
  </ItemGroup>

  <!--
    PresentMon 以嵌入资源的形式打进 exe，发布物因此只有一个文件；
    首次运行释放到 %LOCALAPPDATA%\PerfOverlay\bin\<版本>\（见 PresentMonProvider）。
    不再复制到输出目录，发布包里也就不会多出一个 tools 文件夹。
  -->
  <ItemGroup>
    <EmbeddedResource Include="tools\PresentMon.exe" LogicalName="PerfOverlay.PresentMon.exe" />
    <!--
      AMDFamily17：PawnIO 的官方 AMD 模块（10,652 B，来自 PawnIO.Modules 0.2.11 release）。
      它提供 ioctl_read_smn —— 直接读 AMD 的 SMN 索引/数据寄存器（PCI 配置 0x60/0x64），
      Zen1~Zen5（family 17h~1Ah）全覆盖，所以 5600 和 9600X 走同一条路。
      只有用户明确点了「安装温度组件」、且系统里已有 PawnIO 驱动时才会被加载，
      平时不占内存、不碰硬件；打进 exe 而不是运行时下载，是为了让「装完就能用」
      不依赖第二次网络请求 —— 国内访问 GitHub 本来就时好时坏。
    -->
    <EmbeddedResource Include="tools\AMDFamily17.bin" LogicalName="PerfOverlay.AMDFamily17.bin" />
    <!--
      IntelMSR：PawnIO 的官方 Intel 模块（5,324 B，同一 release）。
      提供 ioctl_read_msr，白名单里包含 IA32_TEMPERATURE_TARGET(0x1A2)、
      IA32_PACKAGE_THERM_STATUS(0x1B1)、IA32_THERM_STATUS(0x19C) 三个只读温度寄存器，
      所以 Intel Core 走的是和 AMD 完全并列的一条路：同样的桥、同样的安装引导。
      只在 CPU 是 Intel 且用户点了安装之后才加载，AMD 机器上永远不会碰到它。
    -->
    <EmbeddedResource Include="tools\IntelMSR.bin" LogicalName="PerfOverlay.IntelMSR.bin" />
    <!--
      托盘图标两套（浅色 / 深色），由 tools/make-icons.py 从 logo 生成。
      打进 exe 而不是放外部文件：托盘图标要在运行时按系统任务栏配色热切换，
      从嵌入资源读一次即可，发布物依旧只有一个 exe。
    -->
    <EmbeddedResource Include="assets\PerfOverlay-light.ico" LogicalName="PerfOverlay.tray-light.ico" />
    <EmbeddedResource Include="assets\PerfOverlay-dark.ico" LogicalName="PerfOverlay.tray-dark.ico" />
  </ItemGroup>

</Project>
