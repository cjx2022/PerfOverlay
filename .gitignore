# 构建产物
bin/
obj/
*.user
*.suo
.vs/

# 本机调试产物（截图、探针日志、验证脚本体）
_shots/
_tools/
_test/*.bat
_test/*.txt
# _test 顶层散落的调试件不进库；回放用例（_test/csv）才是要留的
_test/*
!_test/csv/
dist/

# 发布过程的临时物（release notes 本身留档，URL 不存）
_release/*.txt

# 打包与临时文件
*.zip
*.7z
*.log
*.tmp

# 介绍视频工程（素材/中间产物/成片，体积大，不入库）
video/

# 本地归档（旧版本产物、Downloads 搬迁的历史 exe，不入库）
_archive/
